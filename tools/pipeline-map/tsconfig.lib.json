{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "out-tsc",
    "tsBuildInfoFile": "out-tsc/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    // Plain Node ESM, checked by TypeScript. Parameters are untyped.
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": false
  },
  "include": ["src/**/*.mjs"],
  "exclude": ["src/**/*.spec.mjs", "src/fixtures/**"],
  "references": []
}
