{
  "$schema": "https://json-schema.org/schema",
  "$id": "WorkspaceComponent",
  "title": "Create a React component with a story and a spec",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Component name, e.g. \"date-picker\" or \"DatePicker\".",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "Component name?"
    },
    "project": {
      "type": "string",
      "default": "ui",
      "description": "Project to add it to. Stories are generated when the project has Storybook.",
      "x-dropdown": "projects"
    }
  },
  "required": ["name"]
}
