{
  "$schema": "https://json-schema.org/schema",
  "$id": "WorkspaceSpike",
  "title": "Create a throwaway experiment in apps/sandbox",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Short kebab-case slug describing the experiment.",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "Spike name (kebab-case)?"
    }
  },
  "required": ["name"]
}
