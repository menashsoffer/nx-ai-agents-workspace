{
  "name": "@starter/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.27.0+sha512.ad12821463bb143295f1fa3ecde77a6b9b97a7990386da800ff57bffc3964dc64b7b1c7559d5dbe5c337aea659ed9c8937d4370bd198ca2009bc6fa0249808e7",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "nx run site:dev",
    "build": "nx run-many -t build",
    "storybook": "nx run ui:storybook",
    "test": "nx run-many -t test",
    "e2e": "nx run site-e2e:e2e",
    "e2e:pages": "nx e2e pages-e2e",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "format": "nx format:write --all",
    "verify": "nx sync && nx format:check --all && knip --dependencies && nx run-many -t lint typecheck test build && pnpm test:pipeline && pnpm pipeline:map:check",
    "verify:affected": "nx sync && nx format:check --all && knip --dependencies && nx affected -t lint typecheck test build && pnpm test:pipeline && pnpm pipeline:map:check",
    "test:pipeline": "node --test .github/scripts/*.test.mjs",
    "pipeline:map": "node tools/pipeline-map/src/cli.mjs",
    "pipeline:map:check": "node tools/pipeline-map/src/cli.mjs --check",
    "graph": "nx graph",
    "new:app": "nx g @starter/workspace-plugin:app",
    "new:lib": "nx g @starter/workspace-plugin:lib",
    "new:component": "nx g @starter/workspace-plugin:component",
    "new:spike": "nx g @starter/workspace-plugin:spike",
    "prepare": "simple-git-hooks",
    "template:init": "node tools/scripts/init-template.mjs",
    "template:smoke": "bash tools/scripts/template-smoke.sh",
    "pages:build": "nx run-many -t build build-storybook -p site ui && node tools/pages/src/assemble.mjs",
    "pages:serve": "node tools/pages/src/serve.mjs",
    "security": "node tools/security/src/run.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nx/devkit": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/playwright": "23.2.1",
    "@nx/plugin": "23.2.1",
    "@nx/react": "23.2.1",
    "@nx/storybook": "23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@nx/web": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@playwright/test": "^1.37.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react": "^10.5.0",
    "@storybook/react-vite": "^10.5.0",
    "@swc-node/register": "~1.12.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.16.2",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "~5.0.1",
    "@vitest/ui": "~5.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jiti": "2.7.0",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "knip": "^6.37.0",
    "lint-staged": "^17.5.1",
    "nx": "23.2.1",
    "prettier": "~3.9.7",
    "simple-git-hooks": "^2.14.0",
    "storybook": "^10.5.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "~5.0.1",
    "yaml": "^2.9.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
