{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc/app",
    "tsBuildInfoFile": "out-tsc/app/tsconfig.app.tsbuildinfo",
    "lib": ["es2022", "dom"],
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true,
    "rootDir": "."
  },
  "include": [".vitepress/**/*.ts", "src/**/*.ts"],
  "exclude": ["out-tsc", "dist", "src/**/*.spec.ts"]
}
